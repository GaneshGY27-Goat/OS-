
#include <iostream>
#include <unistd.h>
#include <sys/wait.h>
#include <cstdlib>

using namespace std;

int main()
{
    pid_t pid;

    cout << "Parent Process Started" << endl;
    cout << "Parent PID: " << getpid() << endl;

    pid = fork();

    if(pid < 0)
    {
        cout << "Fork Failed!" << endl;
        exit(1);
    }
    else if(pid == 0)
    {
        // Child Process
        cout << "\nChild Process Created" << endl;
        cout << "Child PID: " << getpid() << endl;
        cout << "Parent PID: " << getppid() << endl;

        cout << "Child Process Terminated" << endl;
        exit(0);
    }
    else
    {
        // Parent Process
        int status;

        cout << "\nParent Process Waiting..." << endl;

        wait(&status);

        cout << "Child Process Completed" << endl;

        if(WIFEXITED(status))
        {
            cout << "Exit Status: "
                 << WEXITSTATUS(status) << endl;
        }
    }

    return 0;
}
