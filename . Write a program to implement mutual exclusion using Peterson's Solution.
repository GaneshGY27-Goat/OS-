#include <iostream>
#include <pthread.h>
#include <unistd.h>

using namespace std;

bool flag[2] = {false, false};
int turn;
int sharedData = 0;

void* process(void* arg)
{
    int id = *(int*)arg;
    int other = 1 - id;

    // Entry Section
    flag[id] = true;
    turn = other;

    while(flag[other] && turn == other)
    {
        // Busy waiting
    }

    // Critical Section
    cout << "Process " << id
         << " entered Critical Section." << endl;

    sharedData++;

    cout << "Process " << id
         << " updated shared data to: "
         << sharedData << endl;

    sleep(1);

    cout << "Process " << id
         << " leaving Critical Section." << endl;

    // Exit Section
    flag[id] = false;

    return NULL;
}

int main()
{
    pthread_t t1, t2;

    int id1 = 0;
    int id2 = 1;

    cout << "Peterson's Solution" << endl;
    cout << "Mutual Exclusion Demonstration"
         << endl << endl;

    pthread_create(&t1, NULL, process, &id1);
    pthread_create(&t2, NULL, process, &id2);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    cout << "\nFinal Shared Data: "
         << sharedData << endl;

    cout << "Program Completed." << endl;

    return 0;
}
