#include <iostream>
#include <unistd.h>
#include <sys/wait.h>
#include <cstdlib>

using namespace std;

int main()
{
    pid_t pid;

    pid = fork();

    if (pid < 0)
    {
        cout << "Process creation failed!" << endl;
        return 1;
    }

    else if (pid == 0)
    {
        cout << "Child Process Started" << endl;
        cout << "Child PID : " << getpid() << endl;

        cout << "Child is terminating using exit()." << endl;

        exit(5);      // Child terminates with exit status 5

        cout << "This statement will never execute." << endl;
    }

    else
    {
        int status;

        cout << "Parent Process Waiting..." << endl;

        wait(&status);

        cout << "Child Process Terminated." << endl;

        if (WIFEXITED(status))
        {
            cout << "Exit Status = "
                 << WEXITSTATUS(status) << endl;
        }
    }

    return 0;
}
