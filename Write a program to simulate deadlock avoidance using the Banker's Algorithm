
#include <iostream>
using namespace std;

int main()
{
    int n, m;
    int alloc[10][10], max[10][10], need[10][10];
    int avail[10], work[10];
    int finish[10] = {0};
    int safe[10];
    int count = 0;

    cout << "Enter number of processes: ";
    cin >> n;

    cout << "Enter number of resources: ";
    cin >> m;

    if(n < 1 || n > 10 || m < 1 || m > 10)
    {
        cout << "Invalid input!";
        return 0;
    }

    cout << "\nEnter Allocation Matrix:\n";
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < m; j++)
        {
            cin >> alloc[i][j];
        }
    }

    cout << "\nEnter Maximum Matrix:\n";
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < m; j++)
        {
            cin >> max[i][j];
        }
    }

    cout << "\nEnter Available Resources:\n";
    for(int j = 0; j < m; j++)
    {
        cin >> avail[j];
        work[j] = avail[j];
    }

    // Calculate Need Matrix
    cout << "\nNeed Matrix:\n";

    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < m; j++)
        {
            if(max[i][j] < alloc[i][j])
            {
                cout << "Invalid resource allocation!";
                return 0;
            }

            need[i][j] = max[i][j] - alloc[i][j];
            cout << need[i][j] << " ";
        }
        cout << endl;
    }

    // Banker's Algorithm
    while(count < n)
    {
        int found = 0;

        for(int i = 0; i < n; i++)
        {
            if(finish[i] == 0)
            {
                int possible = 1;

                for(int j = 0; j < m; j++)
                {
                    if(need[i][j] > work[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                if(possible)
                {
                    for(int j = 0; j < m; j++)
                    {
                        work[j] += alloc[i][j];
                    }

                    safe[count] = i;
                    count++;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }

        if(found == 0)
            break;
    }

    // Display Safe Sequence
    if(count == n)
    {
        cout << "\nSystem is in SAFE state.\n";
        cout << "Safe Sequence: ";

        for(int i = 0; i < n; i++)
        {
            cout << "P" << safe[i] << " ";
        }

        cout << endl;
    }
    else
    {
        cout << "\nSystem is in UNSAFE state.\n";
        cout << "Deadlock may occur.\n";
    }

    return 0;
}
