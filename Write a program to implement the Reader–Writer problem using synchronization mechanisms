
#include <iostream>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

using namespace std;

sem_t mutex;
sem_t wrt;

int readCount = 0;
int sharedData = 100;

void* reader(void* arg)
{
    int id = *(int*)arg;

    // Entry section
    sem_wait(&mutex);

    readCount++;

    if(readCount == 1)
    {
        sem_wait(&wrt);
    }

    sem_post(&mutex);

    // Reading section
    cout << "Reader " << id
         << " is reading data: "
         << sharedData << endl;

    sleep(1);

    // Exit section
    sem_wait(&mutex);

    readCount--;

    if(readCount == 0)
    {
        sem_post(&wrt);
    }

    sem_post(&mutex);

    return NULL;
}

void* writer(void* arg)
{
    int id = *(int*)arg;

    sem_wait(&wrt);

    // Writing section
    sharedData += 10;

    cout << "Writer " << id
         << " is writing data: "
         << sharedData << endl;

    sleep(1);

    sem_post(&wrt);

    return NULL;
}

int main()
{
    pthread_t r[3], w[2];

    int readerID[3] = {1, 2, 3};
    int writerID[2] = {1, 2};

    sem_init(&mutex, 0, 1);
    sem_init(&wrt, 0, 1);

    cout << "Reader-Writer Problem" << endl;
    cout << "Initial Shared Data: "
         << sharedData << endl << endl;

    // Create reader threads
    for(int i = 0; i < 3; i++)
    {
        pthread_create(&r[i], NULL, reader, &readerID[i]);
    }

    // Create writer threads
    for(int i = 0; i < 2; i++)
    {
        pthread_create(&w[i], NULL, writer, &writerID[i]);
    }

    // Wait for readers
    for(int i = 0; i < 3; i++)
    {
        pthread_join(r[i], NULL);
    }

    // Wait for writers
    for(int i = 0; i < 2; i++)
    {
        pthread_join(w[i], NULL);
    }

    cout << "\nFinal Shared Data: "
         << sharedData << endl;

    sem_destroy(&mutex);
    sem_destroy(&wrt);

    return 0;
}
